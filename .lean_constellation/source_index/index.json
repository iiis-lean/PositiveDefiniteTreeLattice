            }
          },
          "ref_id": "ref_0010",
          "role": "primary"
        }
      ],
      "subtype": null,
      "summary": "For a nonzero vector in an admissible rooted tree, norm minus its root coefficient is positive, using positive definiteness or the dual root vector and capacity bound.",
      "title": "Root coefficient bound",
      "updated_at": "2026-07-21T19:42:08Z"
    },
