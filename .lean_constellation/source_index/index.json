              "path": "problem.tex",
              "start_line": 35
            }
          },
          "ref_id": "ref_0007",
          "role": "primary"
        }
      ],
      "subtype": null,
      "summary": "The source theorem concludes that a positive-definite finite integer-weighted tree with a unique vertex whose weight is below degree contains an irreducible basis vertex.",
      "title": "Mathematical irreducible-vertex theorem",
      "updated_at": "2026-07-21T19:42:08Z"
    },
    "b_0007": {
      "active": true,
      "block_id": "b_0007",
      "child_ids": [],
      "created_at": "2026-07-21T19:41:11Z",
      "kind": "lemma",
      "lifecycle_status": "completed",
      "link_ids": [
        "link_0007"
      ],
      "parent_id": "root",
      "refs": [
