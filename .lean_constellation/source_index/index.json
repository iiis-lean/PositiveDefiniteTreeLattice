            }
          },
          "ref_id": "ref_0012",
          "role": "primary"
        }
      ],
      "subtype": null,
      "summary": "A rooted tree is admissible when positive definite, all weights are at least two, and each weight is at least its child count plus one; its capacity is the root diagonal entry of the inverse Gram matrix.",
      "title": "Admissible rooted trees and capacity",
      "updated_at": "2026-07-21T19:42:08Z"
    },
    "b_0009": {
      "active": true,
      "block_id": "b_0009",
      "child_ids": [],
      "created_at": "2026-07-21T19:41:11Z",
      "kind": "lemma",
      "lifecycle_status": "completed",
      "link_ids": [
        "link_0011",
        "link_0015"
      ],
      "parent_id": "root",
      "refs": [
        {
          "material_ref": {
            "kind": "source",
            "ref": {
              "end_line": 82,
              "path": "solution.tex",
              "start_line": 47
            }
          },
          "ref_id": "ref_0008",
          "role": "primary"
        }
      ],
      "subtype": null,
      "summary": "For an admissible rooted tree, capacity is the reciprocal Schur complement at the root and lies strictly between zero and one.",
      "title": "Capacity recursion and strict bounds",
      "updated_at": "2026-07-21T19:42:08Z"
    },
    "b_0010": {
      "active": true,
      "block_id": "b_0010",
      "child_ids": [],
