      ],
      "subtype": null,
      "summary": "The problem defines the weighted-tree lattice bilinear form on the vertex basis, positive definiteness on nonzero lattice vectors, and irreducibility by exclusion of nonzero decompositions with nonnegative pairing.",
      "title": "Tree lattice, positive definiteness, and irreducibility",
      "updated_at": "2026-07-21T19:42:08Z"
    },
    "b_0006": {
      "active": true,
