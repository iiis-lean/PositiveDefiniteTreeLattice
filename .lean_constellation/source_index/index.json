            "kind": "source",
            "ref": {
              "end_line": 31,
              "path": "solution.tex",
              "start_line": 19
            }
          },
          "ref_id": "ref_0006",
          "role": "primary"
        }
      ],
      "subtype": null,
      "summary": "In an integral positive-definite lattice, a vector of norm one is irreducible, since a prohibited decomposition would give norm at least two.",
      "title": "Norm-one elements are irreducible",
      "updated_at": "2026-07-21T19:42:08Z"
    },
    "b_0008": {
      "active": true,
      "block_id": "b_0008",
