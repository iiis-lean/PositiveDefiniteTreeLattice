          "ref_id": "ref_0009",
          "role": "primary"
        }
      ],
      "subtype": null,
      "summary": "For every vector and integer k in an admissible rooted tree, the norm-root-coefficient expression plus gamma k(k+1) is nonnegative; the proof inducts using subtree estimates and an integer-distance bound.",
      "title": "Rooted integer estimate",
      "updated_at": "2026-07-21T19:42:08Z"
    },
    "b_0011": {
      "active": true,
      "block_id": "b_0011",
